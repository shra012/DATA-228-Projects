# Google Managed Kafka Configuration
KAFKA_BOOTSTRAP_SERVERS=bootstrap.<cluster-name>.<region>.managedkafka.<project-id>.cloud.goog:9092
KAFKA_TOPIC=<topic-name>
KAFKA_CLIENT_ID=<client-id>
KAFKA_LINGER_MS=100
KAFKA_BATCH_NUM_MESSAGES=1000
PRODUCER_SLEEP_SECS=1.0
GCP_IAM_SCOPE=https://www.googleapis.com/auth/cloud-platform
