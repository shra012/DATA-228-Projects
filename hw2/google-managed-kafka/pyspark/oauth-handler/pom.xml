<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.google.cloud.kafka</groupId>
    <artifactId>google-cloud-kafka-pyspark-auth</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>

    <name>Google Cloud Kafka PySpark Auth</name>
    <description>Shaded Google Cloud Managed Kafka authentication for PySpark</description>

    <properties>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <kafka.version>3.7.2</kafka.version>
        <managed.kafka.auth.version>1.0.5</managed.kafka.auth.version>
    </properties>

    <dependencies>
        <!-- Kafka Clients (provided by Spark) -->
        <dependency>
            <groupId>org.apache.kafka</groupId>
            <artifactId>kafka-clients</artifactId>
            <version>${kafka.version}</version>
            <scope>provided</scope>
        </dependency>

        <!-- Google Cloud Managed Kafka Auth Handler -->
        <dependency>
            <groupId>com.google.cloud.hosted.kafka</groupId>
            <artifactId>managed-kafka-auth-login-handler</artifactId>
            <version>${managed.kafka.auth.version}</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Maven Compiler Plugin -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.11.0</version>
                <configuration>
                    <source>17</source>
                    <target>17</target>
                </configuration>
            </plugin>

            <!-- Maven Shade Plugin - Create shaded JAR -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.5.0</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                        <exclude>META-INF/LICENSE*</exclude>
                                        <exclude>META-INF/NOTICE*</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                            <!-- Relocate ALL Google/Guava dependencies to avoid conflicts -->
                            <relocations>
                                <!-- Guava -->
                                <relocation>
                                    <pattern>com.google.common</pattern>
                                    <shadedPattern>com.google.cloud.kafka.shaded.common</shadedPattern>
                                </relocation>
                                <!-- Google HTTP Client -->
                                <relocation>
                                    <pattern>com.google.api.client</pattern>
                                    <shadedPattern>com.google.cloud.kafka.shaded.api.client</shadedPattern>
                                </relocation>
                                <!-- Google Auth -->
                                <relocation>
                                    <pattern>com.google.auth</pattern>
                                    <shadedPattern>com.google.cloud.kafka.shaded.auth</shadedPattern>
                                </relocation>
                                <!-- Protobuf -->
                                <relocation>
                                    <pattern>com.google.protobuf</pattern>
                                    <shadedPattern>com.google.cloud.kafka.shaded.protobuf</shadedPattern>
                                </relocation>
                                <!-- Gson -->
                                <relocation>
                                    <pattern>com.google.gson</pattern>
                                    <shadedPattern>com.google.cloud.kafka.shaded.gson</shadedPattern>
                                </relocation>
                                <!-- Apache HTTP Components -->
                                <relocation>
                                    <pattern>org.apache.http</pattern>
                                    <shadedPattern>com.google.cloud.kafka.shaded.http</shadedPattern>
                                </relocation>
                                <!-- OpenCensus -->
                                <relocation>
                                    <pattern>io.opencensus</pattern>
                                    <shadedPattern>com.google.cloud.kafka.shaded.opencensus</shadedPattern>
                                </relocation>
                                <!-- gRPC -->
                                <relocation>
                                    <pattern>io.grpc</pattern>
                                    <shadedPattern>com.google.cloud.kafka.shaded.grpc</shadedPattern>
                                </relocation>
                            </relocations>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
